{
  "name": "@insightly/mcp-server",
  "version": "0.1.0",
  "description": "Insightly MCP server: app review analysis and competitor comparison from Insightly's cached public reports.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "insightly-mcp": "dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "start:http": "node dist/src/index.js --http",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
